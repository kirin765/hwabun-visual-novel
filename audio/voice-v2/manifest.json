  "auditions": [
    {
      "speaker": "miran",
      "label": "같은 문장",
      "text": "오늘 다 정하려구 말아요. 그럼 오늘은 비나 그치기를 기다릴까요.",
      "file": "miran_common.wav"
    },
    {
      "speaker": "miran",
      "label": "실제 1화",
      "text": "점잖게 언니 행세 좀 해요. 괴덕만 부리지 말구.",
      "file": "miran_episode1.wav"
    },
    {
      "speaker": "seran",
      "label": "같은 문장",
      "text": "오늘 다 정하려구 말아요. 그럼 오늘은 비나 그치기를 기다릴까요.",
      "file": "seran_common.wav"
    },
    {
      "speaker": "seran",
      "label": "실제 1화",
      "text": "알거든 길이나 비켜 주지. 날마다 옷섶을 붙들구 놓질 않으니.",
      "file": "seran_episode1.wav"
    },
    {
      "speaker": "danju",
      "label": "같은 문장",
      "text": "오늘 다 정하려구 말아요. 그럼 오늘은 비나 그치기를 기다릴까요.",
      "file": "danju_common.wav"
    },
    {
      "speaker": "danju",
      "label": "실제 1화",
      "text": "새 레코드예요. 봄 노래라기에 가져왔죠.",
      "file": "danju_episode1.wav"
    },
    {
      "speaker": "hyunma",
      "label": "같은 문장",
      "text": "오늘 다 정하려구 말아요. 그럼 오늘은 비나 그치기를 기다릴까요.",
      "file": "hyunma_common.wav"
    },
    {
      "speaker": "hyunma",
      "label": "실제 1화",
      "text": "단주는 꽃두 레코드두 그냥 지나치질 못해.",
      "file": "hyunma_episode1.wav"
    },
    {
      "speaker": "oknyeo",
      "label": "같은 문장",
      "text": "오늘 다 정하려구 말아요. 그럼 오늘은 비나 그치기를 기다릴까요.",
      "file": "oknyeo_common.wav"
    },
    {
      "speaker": "oknyeo",
      "label": "실제 1화",
      "text": "그럼요. 제가 아니면 물이 저 혼자 끓나요.",
      "file": "oknyeo_episode1.wav"
    },
    {
      "speaker": "miran",
      "label": "긴 대사 반복",
      "text": "집에선 말 한마디면 되는 줄 알지. 웃으라면 웃구, 잠자쿠 있으라면 있구. 내 마음은 어디 있나요. 오늘 다 정하려구 말아요. 그럼 오늘은 비나 그치기를 기다릴까요. 오늘 다 정하려구 말아요. 그럼 오늘은 비나 그치기를 기다릴까요.",
      "file": "miran_long.wav"
    },
    {
      "speaker": "miran",
      "label": "피아노·비와 함께",
      "text": "집에선 말 한마디면 되는 줄 알지. 웃으라면 웃구, 잠자쿠 있으라면 있구. 내 마음은 어디 있나요. 오늘 다 정하려구 말아요. 그럼 오늘은 비나 그치기를 기다릴까요. 오늘 다 정하려구 말아요. 그럼 오늘은 비나 그치기를 기다릴까요.",
      "file": "miran_mixed.wav"
